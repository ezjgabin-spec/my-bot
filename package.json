{
  "name": "studypredict-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Private Windows study practice and grade predictions",
  "author": "StudyPredict",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "desktop:prepare": "npm run build && node scripts/prepare-desktop.mjs",
    "desktop": "electron desktop/staging/app",
    "desktop:win": "npm run build && node scripts/prepare-desktop.mjs win32 && electron-builder --config electron-builder.json --win --x64 --publish never",
    "desktop:win:zip": "npm run build && node scripts/prepare-desktop.mjs win32 && electron-builder --config electron-builder.json --win zip --x64 --publish never",
    "test:desktop": "node scripts/smoke-desktop.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "format": "prettier --write src tests *.ts *.mjs *.json README.md"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "lucide-react": "^1.58.0",
    "mammoth": "^1.13.0",
    "next": "^16.4.2",
    "pdf-parse": "^2.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  }
}
