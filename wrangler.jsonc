{
  "$schema": "node_modules/wrangler/config-schema.json",
"name": "studybot",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "studypredict" },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "studypredict",
      "database_id": "17c649e3-ea6d-4a7a-ba38-02f89159de7e",
      "migrations_dir": "cloudflare/migrations",
    },
  ],
  "r2_buckets": [
    { "binding": "MATERIALS", "bucket_name": "studypredict-materials" },
  ],
  "vars": {
    "STUDYPREDICT_CLOUD": "1",
    "APP_ORIGIN": "https://studypredict.your-subdomain.workers.dev",
    "CF_ACCESS_TEAM_DOMAIN": "your-team.cloudflareaccess.com",
    "CF_ACCESS_AUD": "",
    "ALLOWED_EMAILS": "*",
    "AI_DAILY_USER_LIMIT": "10",
    "AI_DAILY_SITE_LIMIT": "30",
    "ANTHROPIC_MODEL": "claude-sonnet-4-6",
  },
  "observability": { "enabled": true },
}
